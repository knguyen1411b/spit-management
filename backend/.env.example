# Application
APPLICATION_NAME=ServerApplication

# Super Admin
SUPER_USER_USERNAME=admin
SUPER_USER_PASSWORD=admin123

# JWT Security
JWT_SECRET=your_jwt_secret
JWT_ACCESS_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=604800000

# Database
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/db_name
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_password

# Thread Pool (Task Execution)
THREAD_POOL_CORE_SIZE=10
THREAD_POOL_MAX_SIZE=50
THREAD_POOL_QUEUE_CAPACITY=100

# Tomcat Server
PORT=8080
TOMCAT_MAX_THREADS=200
TOMCAT_MIN_SPARE_THREADS=20
TOMCAT_MAX_QUEUE_CAPACITY=500

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret